<?xml version="1.0" encoding="utf-8"?><!--
   Backup before Android 12 (pass-docs, Step 131, app-decisions "Android: резервное копирование") - nothing, cloud
   and device to device alike. `allowBackup="false"` in the manifest turns it off, the excludes keep it so if that is
   ever turned back on (rules without an include mean "everything"). Android 12+ reads data_extraction_rules instead.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
    <exclude domain="device_root" path="." />
    <exclude domain="device_file" path="." />
    <exclude domain="device_database" path="." />
    <exclude domain="device_sharedpref" path="." />
</full-backup-content>
